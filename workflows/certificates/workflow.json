      "parameters": {
        "resource": "fileFolder",
        "searchMethod": "query",
        "queryString": "=name = '{{ $('Loop Over Items').item.json.certificate_file.trim().replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\") }}' and '{{ $('Settings').first().json.folder_id }}' in parents and trashed = false",
